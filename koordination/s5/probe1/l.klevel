       "count": 6,
       "value": [
        {
         "items": [
          "Wer läuft mit?",
          "Wir laufen mit!"
         ]
        },
        {
         "items": [
          "Links, rechts, links!",
          "Wir sind nicht zu bremsen!"
         ]
        },
        {
         "items": [
          "Eins, zwei, drei, vier!",
          "Die Straße gehört uns hier!"
         ]
        },
        {
         "items": [
          "Wie weit noch?",
          "Bis zum See und weiter!"
         ]
        },
        {
         "items": [
          "Was wollen wir?",
          "Kilometer!"
         ]
        },
        {
         "items": [
          "Schneller?",
          "Immer schneller!"
         ]
        }
       ],
       "const": true
      },
