       "value": [
        {
         "mood": "bump",
         "lines": [
          "Hey, pass doch auf!",
          "Geht's noch?",
          "Augen auf, Mann!",
          "Was soll das denn?",
          "Mann, ey!",
          "Hast du keine Augen im Kopf?"
         ],
         "n": 6
        },
        {
         "mood": "angry",
         "lines": [
          "Na warte!",
          "Jetzt reicht's mir!",
          "Willst du Ärger?",
          "Komm her, du Idiot!",
          "Dir zeig ich's!",
          "Du hast sie doch nicht alle!"
         ],
         "n": 6
        },
        {
         "mood": "scared",
         "lines": [
          "Hilfe!",
          "Weg hier!",
          "Der ist verrückt!",
          "Lauf!",
          "Polizei! Hilfe!"
         ],
         "n": 5
        },
        {
         "mood": "nearmiss",
         "lines": [
          "Bist du blind?!",
          "Langsam, du Irrer!",
          "Spinnst du?!",
          "Pass doch auf, du Vollidiot!",
          "Fahr doch nicht wie ein Henker!"
         ],
         "n": 5
        },
        {
         "mood": "honked",
         "lines": [
          "Ja ja, ist ja gut!",
          "Reg dich ab!",
          "Hup nicht so!",
          "Selber!"
         ],
         "n": 4
        }
       ],
       "const": true
      },
