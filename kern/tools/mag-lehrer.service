[Unit]
Description=Kern Lehrer remote training (private MAG)
After=network.target

[Service]
Type=simple
User=chris
Group=chris
SupplementaryGroups=render video
EnvironmentFile=/etc/kern-lehrer.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/kern-lehrer/kern/tools/lehrer_remote.py --binary /opt/kern-lehrer/build-hip/kern_lehrer --build ${KERN_LEHRER_BUILD} --jobs /var/lib/kern-lehrer/jobs --tailnet-only --hook /usr/local/lib/kern-lehrer/mag-exclusive.py
ExecStopPost=+/usr/bin/python3 /usr/local/lib/kern-lehrer/mag-exclusive.py leave
StateDirectory=kern-lehrer
UMask=0077
Restart=on-failure
RestartSec=5
# Let the HTTP supervisor stop/checkpoint its native process before the
# systemd kill deadline. Any surviving children are killed at the deadline.
KillMode=mixed
TimeoutStopSec=360
CPUAccounting=yes
# No CPUAffinity, CPUQuota, HIP_VISIBLE_DEVICES or memory cap: use the whole host.
[Install]
WantedBy=multi-user.target
