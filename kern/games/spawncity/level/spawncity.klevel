       5,
       "then",
       6,
       "exec"
      ],
      [
       7,
       "then",
       8,
       "exec"
      ]
     ],
     "machines": [],
     "functions": [
      {
       "name": "WaterLook_vertex_declarations",
       "pure": true,
       "inputs": [],
       "outputs": [
        {
         "name": "Result",
         "type": "text",
         "value": ""
        }
       ]
