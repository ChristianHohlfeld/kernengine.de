     "functions": [
      {
       "name": "Snap",
       "pure": true,
       "help": "A value as the setting takes it: inside its range, on its step; a toggle is 0 or 1",
       "inputs": [
        {
         "name": "option",
         "type": "struct",
         "of": "Option",
         "value": {
          "Key": "",
          "Section": "",
          "Label": "",
          "Help": "",
          "Min": 0,
          "Max": 1,
          "Step": 1,
          "Default": 0,
          "Toggle": false,
          "Live": true
         }
        },
        {
         "name": "value",
         "type": "f64",
         "value": 0
        }
       ],
       "outputs": [
        {
         "name": "value",
         "type": "f64",
         "value": 0
        }
       ]
      },
      {
       "name": "Word",
       "pure": true,
       "help": "A value given as a word: true / on is 1, false / off is 0",
       "inputs": [
        {
         "name": "text",
         "type": "text",
         "value": ""
        }
       ],
       "outputs": [
        {
         "name": "known",
         "type": "bool",
         "value": false
        },
        {
         "name": "value",
         "type": "f64",
         "value": 0
        }
       ]
      },
      {
       "name": "InSection",
       "pure": true,
       "help": "Is the setting in the section? (No section: every setting is.)",
       "inputs": [
        {
         "name": "option",
         "type": "struct",
         "of": "Option",
         "value": {
          "Key": "",
          "Section": "",
          "Label": "",
          "Help": "",
          "Min": 0,
          "Max": 1,
          "Step": 1,
          "Default": 0,
          "Toggle": false,
          "Live": true
         }
        },
        {
