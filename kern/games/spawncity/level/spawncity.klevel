     "machines": [],
     "functions": [
      {
       "name": "decimal",
       "pure": true,
       "help": "A number of the game's 32-bit state as a Blueprint gets it: the decimal number it stands for. A Blueprint computes with 64-bit numbers (as the original's JavaScript does) and its rules name their thresholds in decimals - 0.1, 2.6, 0.42. The game keeps its state in 32 bit, where \"0.1\" is 0.100000001490116...; passed on as that, it would lie just beyond a threshold of 0.1 it stands exactly on. So a 32-bit number crosses over as the shortest decimal that is this very 32-bit number (0.1f -> 0.1): every comparison of it with a decimal threshold then answers exactly as the comparison in 32 bit did, on both sides of the threshold and on it. The way is one to one and keeps the order: back in 32 bit it is the same number again, and of two numbers the larger stays the larger. (Whole numbers, and numbers beyond the range a game counts in, are what they are.)",
       "inputs": [
        {
         "name": "x",
         "type": "float",
         "value": 0
        }
       ],
       "outputs": [
        {
         "name": "Result",
         "type": "float",
         "value": 0
        }
       ],
       "locals": [
        {
         "name": "d",
         "type": "float",
         "value": 0
        },
        {
         "name": "a",
         "type": "float",
         "value": 0
        },
        {
         "name": "scale",
         "type": "float",
         "value": 0
        },
        {
         "name": "m",
         "type": "float",
         "value": 0
        },
        {
         "name": "m_2",
         "type": "float",
         "value": 0
        },
        {
         "name": "digits",
         "type": "int",
         "value": 0
        },
        {
         "name": "c",
         "type": "float",
         "value": 0
        }
       ]
      }
     ]
    }
   }
