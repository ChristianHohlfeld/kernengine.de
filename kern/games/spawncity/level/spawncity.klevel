         "size": 4,
         "glsl": "aWall"
        }
       ],
       "help": "The same vertex stream Kern's BuildingBuilder fills (key \"wall\", 4 floats).",
       "const": true
      }
     ],
     "uses": [
      "engine_gfx_shader"
     ],
     "implements": "ShaderExtension",
     "nodes": [
      {
       "id": 1,
       "type": "func.entry",
       "x": 0,
