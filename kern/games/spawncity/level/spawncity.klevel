       "value": 9,
       "help": "A junction with an arm at least this wide (m) has lights; the others are first come, first served"
      },
      {
       "name": "Decel",
       "type": "float",
       "value": 3.5,
       "help": "Comfortable braking to a stop line (m/s2)"
      },
      {
       "name": "AmberDecel",
       "type": "float",
       "value": 4,
       "help": "At amber a driver stops if this braking (m/s2) gets him to the line"
      },
      {
       "name": "StopLineM",
       "type": "float",
       "value": 1.5,
       "help": "The stop line is this far (m) before the junction's edge"
      },
      {
       "name": "FirstComeM",
       "type": "float",
       "value": 14,
       "help": "Without lights a driver looks at the junction from this far (m)"
      },
      {
       "name": "ClaimS",
       "type": "float",
       "value": 8,
       "help": "A car holds a junction at most this long (s)"
      },
      {
       "name": "PatienceS",
       "type": "float",
       "value": 4,
       "help": "Right before left: a driver waits this long (s) for cars from the right, then goes"
      },
      {
       "name": "YieldReachM",
       "type": "float",
       "value": 6,
       "help": "world_procedural_population.mjs yieldsToPedestrian: a driver brakes for people this far ahead (m) ..."
      },
      {
       "name": "YieldReachBusM",
       "type": "float",
       "value": 9,
       "help": "... a bus this far"
      },
      {
       "name": "YieldHalfM",
       "type": "float",
       "value": 1.6,
       "help": "... and this far to each side (m) ..."
      },
      {
       "name": "YieldHalfBusM",
       "type": "float",
       "value": 1.95,
       "help": "... a bus this far"
      },
      {
       "name": "HonkPlayerS",
       "type": "float",
       "value": 2.6,
       "help": "honkCheck: blocked by the player a driver honks after this many seconds ..."
      },
      {
       "name": "HonkPersonS",
       "type": "float",
       "value": 7,
       "help": "... by a pedestrian after this many ..."
      },
      {
       "name": "HonkGapS",
       "type": "float",
       "value": 9,
       "help": "... and again after this long at least (s) ..."
      },
      {
       "name": "HonkSpreadS",
       "type": "float",
       "value": 7,
       "help": "... plus up to this (s)"
      },
      {
       "name": "HalfWidthM",
       "type": "float",
       "value": 1.25,
       "help": "driveSpeed: half a car's width (m) ..."
      },
      {
       "name": "HalfWidthBusM",
       "type": "float",
       "value": 1.6,
       "help": "... a bus's ..."
      },
      {
       "name": "HalfLengthM",
       "type": "float",
       "value": 1.9,
       "help": "... half a car's length ..."
      },
      {
       "name": "HalfLengthBusM",
       "type": "float",
       "value": 4,
       "help": "... a bus's"
      },
      {
       "name": "SideMarginM",
       "type": "float",
       "value": 0.6,
       "help": "A vehicle ahead counts when it is no further to the side than half the own body plus this (m)"
      },
      {
       "name": "AheadMinM",
       "type": "float",
       "value": 1,
       "help": "... and its centre lies at least this far ahead (m) ..."
      },
      {
       "name": "AheadMaxM",
       "type": "float",
       "value": 40,
       "help": "... and at most this far"
      },
      {
       "name": "GapKeepM",
       "type": "float",
       "value": 2.5,
       "help": "Of the gap to the vehicle ahead this much (m) is kept ..."
      },
      {
       "name": "HeadwayS",
       "type": "float",
       "value": 1.6,
       "help": "... the rest is driven at this headway (s)"
      }
