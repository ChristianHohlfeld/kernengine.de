         "type": "float",
         "value": 1
        }
       ],
       "outputs": [
        {
         "name": "light",
         "type": "int",
         "value": 0
        }
       ],
       "locals": [
        {
         "name": "T",
         "type": "float",
         "value": 0
        }
       ]
      },
      {
       "name": "MustStop",
       "pure": true,
       "help": "At red a driver stops; at amber if he still can before the line (stop: metres to it)",
       "inputs": [
        {
         "name": "light",
         "type": "int",
         "value": 0
        },
        {
         "name": "stop",
         "type": "float",
         "value": 0
        },
        {
         "name": "speed",
         "type": "float",
         "value": 0
        }
       ],
       "outputs": [
        {
         "name": "stop",
         "type": "bool",
         "value": false
        }
       ]
      },
      {
       "name": "StopSpeed",
       "pure": true,
       "help": "The speed from which comfortable braking stops at the line",
