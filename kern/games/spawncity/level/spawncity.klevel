        {
         "name": "stop",
         "type": "float",
         "value": 0
        }
       ],
       "outputs": [
        {
         "name": "speed",
         "type": "float",
         "value": 0
        }
       ]
      },
      {
       "name": "YieldReach",
       "pure": true,
