         "Min": 0,
         "Max": 1,
         "Step": 1,
         "Default": 0,
         "Toggle": true,
         "Live": true
        },
        {
         "Key": "view.grid",
         "Section": "kamera",
         "Label": "1-m-Raster",
         "Help": "Zeichnet ein Referenzraster von 1 m. Nur Anzeige; hilft, Abstand und Hoehe zu schaetzen.",
         "Min": 0,
         "Max": 1,
         "Step": 1,
         "Default": 0,
         "Toggle": true,
         "Live": true
        },
        {
         "Key": "view.keepLook",
         "Section": "kamera",
         "Label": "Blick halten",
         "Help": "AUS: der Blick schwingt nach vorn zurueck, wenn du loslaesst. AN: er bleibt, wo du ihn gelassen hast.",
         "Min": 0,
         "Max": 1,
         "Step": 1,
         "Default": 0,
         "Toggle": true,
         "Live": true
        },
        {
         "Key": "view.minimapNorth",
         "Section": "kamera",
         "Label": "Minimap nach Norden",
         "Help": "Haelt die Minimap genordet, statt sie mit dir zu drehen.",
         "Min": 0,
         "Max": 1,
         "Step": 1,
         "Default": 0,
         "Toggle": true,
         "Live": true
        },
        {
         "Key": "debug.colliders",
         "Section": "kamera",
         "Label": "Box3D-Kollision zeigen",
         "Help": "Zeigt die Box3D-Kollisionsformen als Drahtgitter. Nur Anzeige, kostet Bildrate.",
         "Min": 0,
         "Max": 1,
         "Step": 1,
         "Default": 0,
         "Toggle": true,
         "Live": true
        },
        {
         "Key": "vr.arms",
         "Section": "kamera",
         "Label": "VR: Laufen mit den Armen",
         "Help": "AUS: klassisch mit den Sticks (links gehen, rechts in Schritten drehen). AN: wie Gorilla Tag, nur ohne Boden - mit dem linken Arm joggen = gehen, mit beiden Armen = rennen; die rechte Hand zielt und schiesst weiter, die Sticks bewegen nicht.",
         "Min": 0,
         "Max": 1,
         "Step": 1,
         "Default": 0,
         "Toggle": true,
         "Live": true
        },
        {
         "Key": "vr.level",
         "Section": "kamera",
         "Label": "VR: Horizont halten",
         "Help": "AN (Komfort): in Jet und FPV-Drohne bleibt der Horizont gerade, nur die Richtung dreht mit. AUS: du sitzt fest im Cockpit und kippst mit der Maschine (Loopings, Rollen).",
         "Min": 0,
         "Max": 1,
         "Step": 1,
         "Default": 1,
         "Toggle": true,
         "Live": true
        },
        {
         "Key": "vr.tunnel",
         "Section": "kamera",
         "Label": "VR: Komfort-Tunnel",
         "Help": "Dunkelt den Rand des Blicks ab, waehrend du kuenstlich gedreht oder beschleunigt wirst (Sticks, Fahrzeuge) - gegen Uebelkeit.",
         "Min": 0,
         "Max": 1,
         "Step": 1,
         "Default": 1,
         "Toggle": true,
         "Live": true
        },
        {
         "Key": "vr.smoothTurn",
         "Section": "kamera",
         "Label": "VR: Weich drehen",
         "Help": "AUS: der rechte Stick dreht in 30-Grad-Schritten (am angenehmsten). AN: er dreht stufenlos, bis 120 Grad pro Sekunde.",
         "Min": 0,
         "Max": 1,
         "Step": 1,
         "Default": 0,
         "Toggle": true,
         "Live": true
        }
       ],
       "help": "Every setting, in the order the game counts them (mouse_settings.mjs, control_semantics.mjs, first_person_control_settings.mjs, vehicle_control_settings.mjs, camera_settings.mjs, stereo_sbs.mjs, audio_settings.mjs, world_options.mjs, settings_help.mjs)"
      }
