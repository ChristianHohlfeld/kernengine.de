     "functions": [
      {
       "name": "HornHz",
       "pure": true,
       "help": "Pitch of the horn at a time: the two tones in turn",
       "inputs": [
        {
         "name": "t",
         "type": "float",
         "value": 0
        }
       ],
       "outputs": [
        {
         "name": "hz",
         "type": "float",
         "value": 466.16
        }
       ]
      },
      {
       "name": "WhoopHz",
       "pure": true,
       "help": "The drone whoop: from the base 720 Hz up over 0.7 s with an easing, then low until 1.05 s",
       "inputs": [
        {
         "name": "t",
         "type": "float",
         "value": 0
        }
       ],
       "outputs": [
        {
         "name": "hz",
         "type": "float",
         "value": 760
        }
       ]
      },
      {
       "name": "SirenGain",
       "pure": true,
       "help": "Level at a distance (silent beyond AudibleM): base * level / (1 + (d / 14)^1.25)",
       "inputs": [
        {
         "name": "base",
         "type": "float",
         "value": 0.06
        },
        {
         "name": "d",
         "type": "float",
         "value": 0
        },
        {
         "name": "level",
         "type": "float",
         "value": 1
        }
       ],
       "outputs": [
        {
         "name": "gain",
         "type": "float",
         "value": 0
        }
       ]
      },
      {
       "name": "SirenCutoff",
       "pure": true,
       "help": "Low-pass cutoff for air absorption: 5200 - 16 d, 900 .. 5200 Hz",
       "inputs": [
        {
         "name": "d",
         "type": "float",
         "value": 0
        }
       ],
       "outputs": [
        {
         "name": "hz",
         "type": "float",
         "value": 5200
        }
       ]
      },
      {
       "name": "VoiceUpdate",
       "pure": true,
       "help": "One siren voice at distance d (below 0: no unit in range): its level, and the Doppler shift from the change of distance, smoothed - no chirp when the nearest unit changes",
       "inputs": [
        {
         "name": "d",
         "type": "float",
         "value": -1
        },
        {
         "name": "dt",
         "type": "float",
         "value": 0
        },
        {
         "name": "base",
         "type": "float",
         "value": 0.06
        },
        {
         "name": "level",
         "type": "float",
         "value": 1
        },
        {
         "name": "haveD",
         "type": "bool",
         "value": false
        },
        {
         "name": "lastD",
         "type": "float",
         "value": 0
        },
        {
         "name": "doppler",
         "type": "float",
         "value": 1
        }
       ],
       "outputs": [
        {
         "name": "gain",
         "type": "float",
         "value": 0
        },
        {
         "name": "haveD",
         "type": "bool",
         "value": false
        },
        {
         "name": "lastD",
         "type": "float",
         "value": 0
        },
        {
         "name": "doppler",
         "type": "float",
         "value": 1
        }
       ],
       "locals": [
        {
         "name": "Shift",
         "type": "float",
         "value": 1
        }
       ]
      },
      {
       "name": "PostArrivalGraceMs",
       "pure": true,
       "help": "wanted_dispatch_guard.mjs: after the police drones are revealed, a grace before the first shot: max(450, 720 - 45 * stars) ms",
       "inputs": [
        {
         "name": "stars",
         "type": "int",
         "value": 1
        }
       ],
       "outputs": [
        {
         "name": "ms",
         "type": "float",
         "value": 675
        }
       ]
      },
      {
       "name": "OrganicRate",
