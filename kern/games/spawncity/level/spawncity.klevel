         "name": "half",
         "type": "float",
         "value": 1.6
        }
       ]
      },
      {
       "name": "Honk",
       "pure": true,
       "help": "A blocked driver honks: after HonkPlayerS in front of the player (HonkPersonS for a pedestrian), then HonkGapS and up to HonkSpreadS more apart (roll 0..1 says how much)",
       "inputs": [
        {
         "name": "byPlayer",
         "type": "bool",
         "value": false
        },
        {
         "name": "since",
         "type": "float",
