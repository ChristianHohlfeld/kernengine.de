     "functions": [
      {
       "name": "JunctionLights",
       "pure": true,
       "help": "Does a junction whose widest arm is this wide have traffic lights?",
       "inputs": [
        {
         "name": "widest",
         "type": "float",
         "value": 6
        }
       ],
       "outputs": [
        {
         "name": "lights",
         "type": "bool",
         "value": false
        }
       ]
      },
      {
       "name": "JunctionRadius",
       "pure": true,
       "help": "A junction's edge (the stop lines) from its widest arm",
       "inputs": [
        {
         "name": "widest",
         "type": "float",
         "value": 6
        }
       ],
       "outputs": [
        {
         "name": "radius",
         "type": "float",
         "value": 8
        }
       ]
      },
      {
       "name": "Light",
       "pure": true,
       "help": "The light (0 green, 1 amber, 2 red) for traffic into a junction at a time: the junction's own offset, and which group the traffic is in - along the junction's axis (headingDot: the heading against the axis) or across it, half a cycle later",
       "inputs": [
        {
         "name": "time",
         "type": "float",
         "value": 0
        },
        {
         "name": "offset",
         "type": "float",
         "value": 0
        },
        {
         "name": "headingDot",
         "type": "float",
         "value": 1
        }
       ],
       "outputs": [
        {
         "name": "light",
         "type": "int",
         "value": 0
        }
       ],
       "locals": [
        {
         "name": "T",
         "type": "float",
         "value": 0
        }
       ]
      },
      {
       "name": "MustStop",
       "pure": true,
       "help": "At red a driver stops; at amber if he still can before the line (stop: metres to it)",
       "inputs": [
        {
         "name": "light",
         "type": "int",
         "value": 0
        },
        {
         "name": "stop",
         "type": "float",
         "value": 0
        },
        {
         "name": "speed",
         "type": "float",
         "value": 0
        }
       ],
       "outputs": [
        {
         "name": "stop",
         "type": "bool",
         "value": false
        }
       ]
      },
      {
       "name": "StopSpeed",
       "pure": true,
       "help": "The speed from which comfortable braking stops at the line",
       "inputs": [
        {
         "name": "stop",
         "type": "float",
         "value": 0
        }
       ],
       "outputs": [
        {
         "name": "speed",
         "type": "float",
         "value": 0
        }
       ]
      },
      {
       "name": "YieldReach",
